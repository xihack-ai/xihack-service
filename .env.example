# 复制为 .env 后填写
# OpenAI 兼容接口地址(可换成任意兼容网关)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_M…mini
# 知识库 JSON 路径(相对项目根目录)
KB_PATH=data/sample_kb.json

# 本地开发通过 SSH 通道连接服务器 PostgreSQL。
# 密码由 scripts/local_backend.py 运行时询问，不写入这个文件。
PGHOST=127.0.0.1
PGPORT=15432
PGDATABASE=xks
PGUSER=postgres
PGCONNECT_TIMEOUT=5
