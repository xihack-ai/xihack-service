    },
    {
      "id": "s_02",
      "title": "【占位】某学报论文一篇",
      "type": "论文",
      "url": "https://example.org/paper",
      "license": "仅引用观点"
    },
    {
      "id": "s_03",
      "title": "【占位】民间传说整理集",
      "type": "民间传说集",
      "url": null,
      "license": "仅引用文字"
    }
  ],
  "claims": [
    {
      "id": "myst_c01",
      "text": "【占位】该器物出土于某遗址第三层,与若干陶器同层出土,周围没有发现明显的后期扰动痕迹。",
      "tier": "FACT",
      "source_id": "s_01",
      "locator": "第2段",
      "entity_ids": [
        "myst_e01",
        "myst_e02"
      ],
      "tags": [
        "出土",
        "遗址"
      ],
      "dispute_note": null
    },
    {
      "id": "myst_c02",
      "text": "【占位】该器物为青铜质地,表面饰有云纹,纹饰边缘有明显的磨损,且磨损集中在器物的一侧。",
      "tier": "FACT",
      "source_id": "s_01",
      "locator": "第4段",
      "entity_ids": [
        "myst_e01"
      ],
      "tags": [
        "工艺",
        "材质",
        "纹饰",
        "使用痕迹"
      ],
      "dispute_note": null
    },
    {
      "id": "myst_c03",
      "text": "【占位】同层出土的其他器物多为日常炊煮所用,遗址中没有发现明确的祭祀类遗物或相关遗迹。",
      "tier": "FACT",
      "source_id": "s_01",
      "locator": "第3段",
      "entity_ids": [
        "myst_e01",
        "myst_e02"
      ],
      "tags": [
        "出土",
        "伴出"
      ],
      "dispute_note": null
    },
    {
      "id": "myst_c04",
      "text": "【占位】学者甲认为其形制与礼仪场合使用的器物相近,据此推测这件器物的用途是礼仪用器。",
      "tier": "THEORY",
      "source_id": "s_02",
      "locator": "p.12",
      "entity_ids": [
        "myst_e01",
        "myst_e03"
      ],
      "tags": [
        "用途",
        "礼仪"
      ],
      "dispute_note": "学者乙持不同意见;该推测主要依据形制类比,缺少直接的出土证据。"
    },
    {
      "id": "myst_c05",
      "text": "【占位】学者乙认为磨损集中在一侧,说明器物曾被反复手持使用,据此推测它是一件日常用器。",
      "tier": "THEORY",
      "source_id": "s_02",
      "locator": "p.27",
      "entity_ids": [
        "myst_e01",
        "myst_e04"
      ],
      "tags": [
        "用途",
        "日常"
      ],
      "dispute_note": "学者甲认为磨损也可能来自仪式中的反复摆放;双方均缺少直接证据。"
    },
    {
      "id": "myst_c06",
      "text": "【占位】同一时期,遗址所在地区还出现过若干件形制相近的器物,数量不多,分布较为分散。",
      "tier": "FACT",
      "source_id": "s_01",
      "locator": "第6段",
      "entity_ids": [
        "myst_e01",
        "myst_e02"
      ],
      "tags": [
        "分布",
        "同类器物"
      ],
      "dispute_note": null
    },
    {
      "id": "myst_c07",
      "text": "【占位】民间传说称这件器物曾属于某位工匠,被用来调制一种特殊的颜料,但传说没有说明年代。",
      "tier": "LEGEND",
      "source_id": "s_03",
      "locator": "卷一",
      "entity_ids": [
        "myst_e01"
      ],
      "tags": [
        "传闻",
        "传说"
      ],
      "dispute_note": "该传说最早见于后世整理的文本,没有同时代的文献或出土物佐证。"
    },
    {
      "id": "myst_c08",
      "text": "【占位】对器物内壁残留物的检测没有发现明确的有机成分,检测结果无法判断它曾盛放过什么。",
      "tier": "FACT",
      "source_id": "s_02",
      "locator": "p.31",
      "entity_ids": [
        "myst_e01"
      ],
      "tags": [
        "检测",
        "残留物"
      ],
      "dispute_note": null
    },
    {
      "id": "thea_c01",
      "text": "【占位】画中茶馆的座位分上首和下首,靠里的座位通常留给年长者或身份较高的客人。",
      "tier": "FACT",
      "source_id": "s_01",
      "locator": "第1段",
      "entity_ids": [
        "thea_e01",
        "thea_e04"
      ],
      "tags": [
        "座次",
        "礼仪"
      ],
      "dispute_note": null
    },
    {
      "id": "thea_c02",
      "text": "【占位】画中的茶杯是带盖的小盖碗,杯身绘有细密的缠枝纹,工艺较为精细,不是寻常人家所用。",
      "tier": "FACT",
      "source_id": "s_01",
      "locator": "第3段",
      "entity_ids": [
        "thea_e01",
        "thea_e03"
      ],
      "tags": [
        "工艺",
        "茶具"
      ],
      "dispute_note": null
    },
    {
      "id": "thea_c03",
      "text": "【占位】画作所属时期,茶叶买卖需要经过官府登记,私自贩卖的商人会受到处罚。",
      "tier": "FACT",
      "source_id": "s_02",
      "locator": "p.8",
      "entity_ids": [
        "thea_e01",
        "thea_e03"
      ],
      "tags": [
        "管理",
        "茶叶"
      ],
      "dispute_note": null
    },
    {
      "id": "thea_c04",
      "text": "【占位】当时的茶馆既是喝茶休息的地方,也是商人洽谈生意、交换各地消息的场所。",
      "tier": "FACT",
      "source_id": "s_01",
      "locator": "第5段",
      "entity_ids": [
        "thea_e01",
        "thea_e02"
      ],
      "tags": [
        "茶馆",
        "商人"
      ],
      "dispute_note": null
    },
    {
      "id": "thea_c05",
      "text": "【占位】有学者认为画中角落里的客人是外地来的行商,判断依据是他的衣着和身边的随身包裹。",
      "tier": "THEORY",
      "source_id": "s_02",
      "locator": "p.31",
      "entity_ids": [
        "thea_e02"
      ],
      "tags": [
        "人物",
        "行商"
      ],
      "dispute_note": "仅凭衣着和包裹判断,缺少文字记载佐证。"
    },
    {
      "id": "thea_c06",
      "text": "【占位】据同时代的笔记记载,靠窗的座位视野最好,最受欢迎,常被熟客提前占用。",
      "tier": "FACT",
      "source_id": "s_02",
      "locator": "p.15",
      "entity_ids": [
        "thea_e01",
        "thea_e04"
      ],
      "tags": [
        "座次",
        "笔记"
      ],
      "dispute_note": null
    },
    {
      "id": "thea_c07",
      "text": "【占位】有说法认为画家有意把角落的座位留空,用来暗示某位没有出现在画面里的人物。",
      "tier": "THEORY",
      "source_id": "s_02",
      "locator": "p.44",
      "entity_ids": [
        "thea_e04"
      ],
      "tags": [
        "构图",
        "解读"
      ],
      "dispute_note": "画作没有题跋,这属于观者的解读,没有画家本人的说明可以核对。"
    },
    {
      "id": "sand_c01",
      "text": "【占位】码头位于河道转弯处,水流较缓,是上下游货船停靠、装卸货物的主要地点。",
      "tier": "FACT",
      "source_id": "s_01",
      "locator": "第1段",
      "entity_ids": [
        "sand_e01",
        "sand_e02"
      ],
      "tags": [
        "码头",
        "河道"
      ],
      "dispute_note": null
    },
    {
      "id": "sand_c02",
      "text": "【占位】货船按载重分为大小几种,大船只能在涨水季节靠泊,小船则全年往来。",
      "tier": "FACT",
      "source_id": "s_01",
      "locator": "第2段",
      "entity_ids": [
        "sand_e01",
        "sand_e03"
      ],
      "tags": [
        "货船",
        "载重"
      ],
      "dispute_note": null
    },
    {
      "id": "sand_c03",
      "text": "【占位】船工多为世代以河为生的人家,一条船上通常由同一家族的几个人共同操作。",
      "tier": "FACT",
      "source_id": "s_02",
      "locator": "p.9",
      "entity_ids": [
        "sand_e03",
        "sand_e04"
      ],
      "tags": [
        "船工",
        "家族"
      ],
      "dispute_note": null
    },
    {
      "id": "sand_c04",
      "text": "【占位】码头附近设有税卡,货船靠岸后需要登记货物的种类和数量,并按规定缴税。",
      "tier": "FACT",
      "source_id": "s_01",
      "locator": "第4段",
      "entity_ids": [
        "sand_e01",
        "sand_e05"
      ],
      "tags": [
        "税卡",
        "登记"
      ],
      "dispute_note": null
    },
    {
      "id": "sand_c05",
      "text": "【占位】盐是码头上最常见的大宗货物之一,从下游运来,在仓库存放后再分发到各地。",
      "tier": "FACT",
      "source_id": "s_02",
      "locator": "p.14",
      "entity_ids": [
        "sand_e01",
        "sand_e06",
        "sand_e07"
      ],
      "tags": [
        "盐",
        "货物"
      ],
      "dispute_note": null
    },
    {
      "id": "sand_c06",
      "text": "【占位】盐仓建在地势较高的位置,用来避免涨水时货物受潮,仓内按批次分区存放。",
      "tier": "FACT",
      "source_id": "s_01",
      "locator": "第5段",
      "entity_ids": [
        "sand_e07"
      ],
      "tags": [
        "盐仓",
        "仓储"
      ],
      "dispute_note": null
    },
    {
      "id": "sand_c07",
      "text": "【占位】河道每年有固定的枯水期,此时大船无法通行,货物只能改由小船或陆路转运。",
      "tier": "FACT",
      "source_id": "s_02",
      "locator": "p.18",
      "entity_ids": [
        "sand_e02",
        "sand_e03"
      ],
      "tags": [
        "河道",
        "枯水期"
      ],
      "dispute_note": null
    },
    {
      "id": "sand_c08",
      "text": "【占位】码头旁的灯塔在夜间点火,为晚到的货船指示靠岸的位置,防止船只误入浅滩。",
      "tier": "FACT",
      "source_id": "s_01",
      "locator": "第6段",
      "entity_ids": [
        "sand_e01",
        "sand_e08"
      ],
      "tags": [
        "灯塔",
        "夜航"
      ],
      "dispute_note": null
    },
    {
      "id": "sand_c09",
      "text": "【占位】有学者认为税卡的位置并非随意设定,而是特意选在船只必须减速的河湾处。",
      "tier": "THEORY",
      "source_id": "s_02",
      "locator": "p.22",
      "entity_ids": [
        "sand_e02",
        "sand_e05"
      ],
      "tags": [
        "税卡",
        "选址"
      ],
      "dispute_note": "该推测依据地形分析得出,缺少当时官方文书的直接说明。"
    },
    {
      "id": "sand_c10",
      "text": "【占位】有说法称灯塔最初是船工自发点起的火堆,后来才由官府接管并修成固定的塔。",
      "tier": "LEGEND",
      "source_id": "s_03",
      "locator": "卷二",
      "entity_ids": [
        "sand_e04",
        "sand_e08"
      ],
      "tags": [
        "灯塔",
        "传说"
      ],
      "dispute_note": "该说法出自后世回忆,没有同时代的记载可以核对。"
    }
  ],
